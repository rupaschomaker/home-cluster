#!/bin/bash -e

push=true
if [ "${1:-}" = "-no-push" ]; then
  push=false
  shift
fi

if [ -z "${1:-}" ]; then
  echo "Usage: $0 [-no-push] <commit log>"
  exit 2
fi

fakeClustertool() {
  sed -i.bak -e 's/v1\.14\.7/v1.14.6/' -e 's/v1\.37\.3/v1.37.2/' talos/clustertool.yaml
}
unfakeClustertool() {
  sed -i.bak -e 's/v1\.14\.6/v1.14.7/' -e 's/v1\.37\.2/v1.37.3/' talos/clustertool.yaml talos/generated/control-1.yaml
}

# fakeClustertool
clustertool genconfig
clustertool genks
# unfakeClustertool

clustertool encrypt
git add doit kubernetes talos .github
git add -u manual
git commit -m "$1"
if [ "$push" = true ]; then
  git pull
  git push
fi
clustertool decrypt
