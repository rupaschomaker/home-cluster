#!/bin/bash -e

push=true
if [ "${1:-}" = "-no-push" ]; then
  push=false
  shift
fi

if [ -z "${1:-}" ]; then
  echo "Usage: $0 [-no-push] <commit log>"
  exit 2
fi

fakeClustertool() {
  sed -i.bak -e 's/v1\.13\.6/v1.11.3/' -e 's/v1\.36\.2/v1.34.3/' clusters/main/talos/talconfig.yaml
}
unfakeClustertool() {
  sed -i.bak -e 's/v1\.11\.3/v1.13.6/' -e 's/v1\.34\.3/v1.36.2/' clusters/main/talos/talconfig.yaml clusters/main/talos/generated/main-k8s-node-1.yaml
}

# fakeClustertool
clustertool genconfig
# unfakeClustertool

clustertool encrypt
git add doit clusters repositories .github
git add -u manual
git commit -m "$1"
if [ "$push" = true ]; then
  git pull
  git push
fi
clustertool decrypt
